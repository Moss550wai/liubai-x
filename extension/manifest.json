{
  "manifest_version": 3,
  "name": "留白 · X 回复筛",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "在本机折叠 X 的模板回复。可展开、可调强度，给注意力留一点白。",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "留白 · 回复过滤", "default_popup": "popup.html"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["model-data.js", "scorer.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}
